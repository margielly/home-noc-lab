# Copy this file to ".env" (same folder as docker-compose.yml) and change the passwords.
# In PowerShell:  copy env.example .env
# Never commit your real .env to GitHub.

POSTGRES_USER=zabbix
POSTGRES_PASSWORD=ChangeMe_Use_A_Long_Unique_Password
POSTGRES_DB=zabbix

# Time zone used by the Zabbix web interface
TZ=America/New_York

# Only needed if you start Grafana (--profile dashboards)
GRAFANA_ADMIN_PASSWORD=ChangeMe_Too
